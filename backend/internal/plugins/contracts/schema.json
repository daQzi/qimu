{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qimu.invalid/contracts/plugin-v3",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "address": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 161
    },
    "path": {
      "type": "string",
      "pattern": "^(skills|operations|pipelines|schemas|views|connectors|blueprints|workbenches|recipes)/[A-Za-z0-9_./-]+$",
      "maxLength": 240
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 40
    },
    "permission": {
      "type": "string",
      "enum": [
        "canvas.read",
        "canvas.write",
        "media.read",
        "asset.read",
        "asset.search",
        "asset.import",
        "asset.upload",
        "generation.run",
        "timeline.read",
        "timeline.command",
        "export.run",
        "connection.use",
        "resource.create"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/permission"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "effect": {
      "type": "string",
      "enum": [
        "read",
        "draft_write",
        "generation",
        "external_write",
        "delete",
        "publish"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_input",
        "waiting_approval",
        "paused",
        "succeeded",
        "failed",
        "cancelling",
        "cancelled"
      ]
    },
    "stepStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "running",
        "waiting_task",
        "waiting_input",
        "waiting_approval",
        "succeeded",
        "failed",
        "skipped",
        "cancelled"
      ]
    },
    "contribution": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "ref": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "id",
        "ref"
      ],
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "entry": {
          "$ref": "#/$defs/path"
        },
        "activation": {
          "type": "string",
          "enum": [
            "auto",
            "explicit"
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "launchOperation": {
          "$ref": "#/$defs/address"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "entry",
        "activation",
        "operations"
      ],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "optional": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "version",
        "optional"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": "yingce.plugin/v3"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "publisher": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "id",
            "displayName"
          ],
          "additionalProperties": false
        },
        "requires": {
          "type": "object",
          "properties": {
            "hostApi": {
              "enum": [
                "^3.0.0",
                "^3.1.0"
              ]
            }
          },
          "required": [
            "hostApi"
          ],
          "additionalProperties": false
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "contributes": {
          "type": "object",
          "properties": {
            "skills": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/skill"
              },
              "minItems": 1,
              "maxItems": 32
            },
            "operations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/contribution"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "views": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/contribution"
              },
              "minItems": 1,
              "maxItems": 32
            },
            "pipelines": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/contribution"
              },
              "minItems": 1,
              "maxItems": 16
            },
            "connectors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/contribution"
              },
              "minItems": 1,
              "maxItems": 16
            },
            "canvasBlueprints": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/contribution"
              },
              "minItems": 1,
              "maxItems": 32
            },
            "workbenches": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/contribution"
              },
              "minItems": 1,
              "maxItems": 16
            },
            "recipes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/contribution"
              },
              "minItems": 1,
              "maxItems": 16
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "apiVersion",
        "id",
        "name",
        "version",
        "description",
        "publisher",
        "requires",
        "permissions",
        "dependencies",
        "contributes"
      ],
      "additionalProperties": false,
      "description": "P00 offline contract profile; runtime still rejects v3. Pipeline/HTTP are separately frozen but not admitted as package contributions yet."
    },
    "contextRequirements": {
      "type": "object",
      "properties": {
        "requiresCanvas": {
          "type": "boolean"
        },
        "requiresProject": {
          "type": "boolean"
        }
      },
      "required": [
        "requiresCanvas",
        "requiresProject"
      ],
      "additionalProperties": false
    },
    "execution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "host"
            },
            "adapter": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]+$",
              "maxLength": 120
            },
            "mode": {
              "type": "string",
              "enum": [
                "inline",
                "task"
              ]
            }
          },
          "required": [
            "kind",
            "adapter",
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "http"
            },
            "connector": {
              "$ref": "#/$defs/id"
            },
            "action": {
              "$ref": "#/$defs/id"
            },
            "mode": {
              "const": "task"
            }
          },
          "required": [
            "kind",
            "connector",
            "action",
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "pipeline"
            },
            "pipeline": {
              "$ref": "#/$defs/id"
            },
            "mode": {
              "const": "task"
            }
          },
          "required": [
            "kind",
            "pipeline",
            "mode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "operation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "inputSchemaRef": {
          "$ref": "#/$defs/path"
        },
        "outputSchemaRef": {
          "$ref": "#/$defs/path"
        },
        "requiredPermissions": {
          "$ref": "#/$defs/permissions"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        },
        "context": {
          "$ref": "#/$defs/contextRequirements"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "resultView": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "description",
        "inputSchemaRef",
        "outputSchemaRef",
        "requiredPermissions",
        "effects",
        "context",
        "execution"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "component": {
          "type": "string",
          "enum": [
            "key-value/v1",
            "table/v1",
            "entity-cards/v1",
            "mapping-editor/v1",
            "media-compare/v1"
          ]
        },
        "schemaRef": {
          "$ref": "#/$defs/path"
        },
        "collectionPath": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 240
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "path",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "component",
        "schemaRef",
        "fields"
      ],
      "additionalProperties": false
    },
    "blueprint": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/id"
              },
              "nodeType": {
                "enum": [
                  "plugin-result",
                  "plugin-input"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "binding": {
                "enum": [
                  "result",
                  "input"
                ]
              },
              "view": {
                "$ref": "#/$defs/id"
              },
              "actions": {
                "type": "array",
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "editor.focus",
                    "input.submit",
                    "result.continue"
                  ]
                }
              }
            },
            "required": [
              "key",
              "nodeType",
              "title",
              "position",
              "binding",
              "view"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 20
        },
        "connections": {
          "type": "array",
          "maxItems": 19,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "$ref": "#/$defs/id"
              },
              "to": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      },
      "required": [
        "id",
        "nodes",
        "connections"
      ],
      "additionalProperties": false
    },
    "httpBinding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "literal": {}
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^(input|resource)\\.[A-Za-z][A-Za-z0-9_-]{0,79}$"
            }
          },
          "required": [
            "from"
          ],
          "additionalProperties": false
        }
      ]
    },
    "httpRequest": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "POST",
            "GET",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "body": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/httpBinding"
          }
        }
      },
      "required": [
        "method",
        "path"
      ],
      "additionalProperties": false
    },
    "httpAction": {
      "type": "object",
      "properties": {
        "submit": {
          "$ref": "#/$defs/httpRequest"
        },
        "poll": {
          "$ref": "#/$defs/httpRequest"
        },
        "lookup": {
          "$ref": "#/$defs/httpRequest"
        },
        "jobIdPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "statusPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "statusMap": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {
            "enum": [
              "pending",
              "succeeded",
              "failed",
              "cancelled"
            ]
          }
        },
        "outputs": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "resources": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "enum": [
              "image",
              "video",
              "audio"
            ]
          }
        },
        "artifact": {
          "type": "object",
          "properties": {
            "urlPath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "kind": {
              "enum": [
                "image",
                "video",
                "audio"
              ]
            }
          },
          "required": [
            "urlPath",
            "field",
            "kind"
          ],
          "additionalProperties": false
        },
        "idempotency": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "unsupported",
                "header"
              ]
            },
            "header": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "retentionSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "cancellation": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "unsupported",
                "request"
              ]
            },
            "request": {
              "$ref": "#/$defs/httpRequest"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "submit",
        "outputs",
        "idempotency",
        "cancellation"
      ],
      "additionalProperties": false
    },
    "httpConnector": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "transport": {
          "const": "http"
        },
        "baseUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "auth": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "none",
                "bearer",
                "header"
              ]
            },
            "header": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "actions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/httpAction"
          }
        }
      },
      "required": [
        "id",
        "transport",
        "baseUrl",
        "auth",
        "actions"
      ],
      "additionalProperties": false
    },
    "resultRef": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "stepKey": {
          "$ref": "#/$defs/id"
        },
        "itemKey": {
          "type": "string",
          "maxLength": 120
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "outputKey": {
          "$ref": "#/$defs/id"
        },
        "schemaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "schemaVersion": {
          "$ref": "#/$defs/version"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "required": [
        "runId",
        "stepKey",
        "itemKey",
        "attempt",
        "outputKey",
        "schemaId",
        "schemaVersion",
        "digest"
      ],
      "additionalProperties": false
    },
    "invocation": {
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/address"
        },
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "input": {
          "type": "object",
          "additionalProperties": {},
          "maxProperties": 128
        },
        "context": {
          "type": "object",
          "properties": {
            "hostSurface": {
              "type": "string",
              "enum": [
                "agent-home",
                "canvas",
                "editor"
              ]
            },
            "canvasId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "threadId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "workbenchId": {
              "$ref": "#/$defs/address"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "workbench": {
          "$ref": "#/$defs/workbenchSelection"
        }
      },
      "required": [
        "operation",
        "releaseId",
        "input"
      ],
      "additionalProperties": false
    },
    "skillBinding": {
      "type": "object",
      "properties": {
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "localSkillId": {
          "$ref": "#/$defs/id"
        },
        "skillVersionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "entryDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "releaseId",
        "localSkillId",
        "skillVersionId",
        "entryDigest"
      ],
      "additionalProperties": false
    },
    "runRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "entryOperation": {
          "$ref": "#/$defs/address"
        },
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 160
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "$ref": "#/$defs/runStatus"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "context": {
          "$ref": "#/$defs/invocationContext"
        },
        "parentRunId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "required": [
        "id",
        "userId",
        "entryOperation",
        "releaseId",
        "idempotencyKey",
        "requestDigest",
        "status",
        "revision",
        "context"
      ],
      "additionalProperties": false
    },
    "invocationContext": {
      "type": "object",
      "properties": {
        "hostSurface": {
          "type": "string",
          "enum": [
            "agent-home",
            "canvas",
            "editor"
          ]
        },
        "canvasId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
