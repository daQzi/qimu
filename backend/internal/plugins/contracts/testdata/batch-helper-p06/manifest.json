{
  "apiVersion": "yingce.plugin/v3",
  "id": "batch-helper",
  "name": "批量流程示例",
  "version": "1.0.0",
  "description": "检查视频，按稳定标识批量调用演示 API，验证条件、批量批准和局部派生。不包含实际生成模型。",
  "publisher": {
    "id": "example-publisher",
    "displayName": "示例作者"
  },
  "requires": {
    "hostApi": "^3.0.0"
  },
  "permissions": [
    "media.read",
    "connection.use"
  ],
  "dependencies": [],
  "contributes": {
    "skills": [
      {
        "id": "workflow",
        "name": "workflow",
        "description": "先检查视频，再等待用户填写远程提示词，确认后执行。",
        "entry": "skills/workflow/SKILL.md",
        "activation": "auto",
        "operations": [
          "batch-helper.process"
        ]
      }
    ],
    "operations": [
      {
        "id": "inspect",
        "ref": "operations/inspect.json"
      },
      {
        "id": "echo",
        "ref": "operations/echo.json"
      },
      {
        "id": "process",
        "ref": "operations/process.json"
      }
    ],
    "pipelines": [
      {
        "id": "process",
        "ref": "pipelines/process.json"
      }
    ],
    "connectors": [
      {
        "id": "api",
        "ref": "connectors/api.json"
      }
    ]
  }
}
